{
  "name": "praxis-monorepo",
  "version": "0.1.1",
  "private": true,
  "description": "An AI-augmented TypeScript/JavaScript utility library, focusing on robust, highly-tested, and educational implementations.",
  "author": "indredk <zys233333@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/indredk/praxis.git"
  },
  "type": "module",
  "scripts": {
    "start": "tsx --tsconfig tsconfig.scripts.json scripts/start.ts",
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:server": "turbo dev --filter=@praxis/mock-server",
    "dev:backend": "turbo dev --filter=@praxis/backend",
    "test": "turbo test",
    "test:watch": "vitest",
    "test:storybook": "vitest run --project storybook",
    "test:ui": "vitest --ui --project unit",
    "test:ui:server": "vitest --ui packages/mock_server/",
    "test:ui:utils": "vitest --ui packages/utils/",
    "test:ui:react-web": "vitest --ui packages/react-web/",
    "test:coverage": "vitest run --coverage",
    "lint": "turbo lint",
    "clean": "turbo clean",
    "typecheck": "turbo typecheck",
    "docs": "typedoc",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo build --filter=@indredk/praxis && changeset publish",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@chromatic-com/storybook": "^5.6.0",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-vitest": "^10.6.5",
    "@storybook/jest": "^0.2.3",
    "@storybook/react-vite": "^10.6.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/glob": "^9.0.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/ui": "^5.0.5",
    "chalk": "^6.0.1",
    "cross-env": "^10.1.0",
    "eslint-plugin-storybook": "^10.6.5",
    "execa": "^10.2.1",
    "glob": "^14.0.3",
    "globals": "^17.13.0",
    "inquirer": "^14.2.5",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "storybook": "^10.6.5",
    "tsup": "^9.0.0",
    "turbo": "^2.11.10",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@10.15.1",
  "license": "ISC",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@nestjs/core",
      "unrs-resolver",
      "@prisma/engines",
      "bcrypt",
      "prisma",
      "@prisma/client"
    ],
    "ignoredBuiltDependencies": [
      "@scarf/scarf"
    ]
  }
}
