{
  "name": "@praxis/mock-server",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "tsup src/index.ts --format cjs --clean",
    "dev": "tsup src/index.ts --format cjs --watch --onSuccess \"node dist/index.js\"",
    "start": "node dist/index.js",
    "test": "vitest run",
    "lint": "eslint . --ext .ts"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "http-proxy-middleware": "^4.2.1",
    "immer": "^11.2.9",
    "lodash": "^4.18.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/lodash": "^4.17.27",
    "@types/nock": "^11.1.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.13.0",
    "nock": "^15.0.5",
    "supertest": "^7.3.1",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3"
  }
}
